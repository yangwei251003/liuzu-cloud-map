# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/%USERPROFILE%/
/.npm-cache/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/output/
/.playwright-cli/

# next.js
/.next/
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/.codex-dev-server.log
/.codex-dev-server-error.log
/.*.stdout.log
/.*.stderr.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Android preview-shell local toolchain and generated outputs
/mobile/android-web-shell/.gradle/
/mobile/android-web-shell/local.properties
/mobile/android-web-shell/build/
/mobile/android-web-shell/app/build/
/mobile/android-web-shell/*.jks
/mobile/android-web-shell/*.keystore

# Local mobile deliverables can embed a revocable Preview share credential.
/mobile/deliverables/*.apk

.vercel

# Generated public preview artifact
preview-dist/
third-party/installed-package-paths.json

.local/
data/raw/
*.gpkg

# Safe configuration template
!.env.example
